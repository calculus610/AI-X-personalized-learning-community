# Local Docker entry point: http://localhost:8080/personalized-secure/
PERSONALIZED_SECURE_PORT=8080

# Local infrastructure credentials. These values are examples for an isolated
# developer machine only; replace them before sharing a reachable deployment.
MYSQL_DATABASE=personalized_secure
MYSQL_USER=personalized_secure
MYSQL_PASSWORD=local-only-mysql-password
MYSQL_ROOT_PASSWORD=local-only-mysql-root-password
MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=local-only-minio-password
JWT_SECRET=local-only-jwt-secret-change-before-shared-use

# Optional third-party AI services. The base platform starts without them.
# Digital-twin free-form chat and live translation need DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=

# HiAgent server-side publication settings. Keep these in .env only.
# Without them, the learning mentor uses the backend fallback response.
AGENT_PROVIDER_URL=
AGENT_PROVIDER_API_KEY=
AGENT_APP_KEY=
HIAGENT_PHASE1_APP_KEY=
HIAGENT_PHASE2_APP_KEY=
HIAGENT_PHASE34_APP_KEY=
HIAGENT_PHASE5_APP_KEY=
